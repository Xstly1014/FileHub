# Copy to .env locally. Never commit a real key or a real JWT secret.
# The OpenAI key below is a placeholder — replace it with your own.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Generate a strong secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
FILEHUB_JWT_SECRET=replace-me
FILEHUB_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8888,http://127.0.0.1:8888
# Optional: upload size limit in bytes (default 25MB).
# FILEHUB_MAX_UPLOAD_BYTES=26214400
